# Public config, injected into index.html at build time by build.js.
# Safe to expose to the browser - protected by Supabase Row Level Security.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_SPA_CLIENT_ID

# Server-only secret, used by api/assistant.js. Never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...
